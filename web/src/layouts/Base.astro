---
import "../styles/taste.css";
import { SITE_NAME, DATA_BASE } from "../lib/data";
interface Props { title?: string; desc?: string; }
const { title, desc } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · 每日羊毛`;
---
<!doctype html>
<html lang="zh-CN" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{pageTitle}</title>
<meta name="description" content={desc ?? "炊事班·每日羊毛：AI 福利、VPS/云、优惠、游戏、软件——人工审核后上架，订阅关键词即推送。"}>
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={desc ?? "人工审核的每日羊毛聚合"}>
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary">
<meta name="theme-color" content="#151517">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍳</text></svg>">
<script is:inline>
if (matchMedia('(prefers-color-scheme: light)').matches) document.documentElement.dataset.theme = 'light'
</script>
</head>
<body>
<nav>
  <a class="skip-link" href="#main">跳到内容</a>
  <div class="wrap">
    <a class="brand" href="/">{SITE_NAME}<em>每日羊毛 · chuishiban.com</em></a>
    <div class="links">
      <a class="hide-s" href="/ranking/">排行</a>
      <a class="hide-s" href="/notify/">订阅推送</a>
    </div>
  </div>
</nav>
<main id="main"><slot /></main>
<footer class="closing">
  <div class="wrap">
    <small>© <span id="yr">2026</span> {SITE_NAME} · 人工审核的羊毛聚合 · 失效条目保留 90 天供参考</small>
    <div class="flinks">
      <a href="/ranking/">排行</a>
      <a href="/notify/">订阅推送</a>
    </div>
  </div>
</footer>
<script is:inline>
document.getElementById('yr').textContent = new Date().getFullYear()
</script>
</body>
</html>
