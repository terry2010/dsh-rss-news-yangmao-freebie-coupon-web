---
import { chName, claimName, daysLeft, goUrl, type ExportItem } from "../lib/data";
interface Props { it: ExportItem; top?: number }
const { it, top } = Astro.props;
const dl = daysLeft(it.deadline);
const expired = it.status === "expired" || (dl !== null && dl < 0);
const date = (it.publishedAt ?? it.createdAt).slice(5, 10).replace("-", "/");
const dlTag = dl === null ? null : dl <= 0 ? "今日到期" : dl <= 3 ? `仅剩${dl}天` : null;
const detail = `/item/${it.slug}/`;
---
<div class:list={["hcard", { brk: it.breaking, expired, top: !!top }]} data-ch={it.category} data-t={it.title} data-date={(it.publishedAt ?? it.createdAt).slice(0, 10)}>
  <h3 class="hd">
    <a href={detail}>
      {top && <span class="tag">TOP{top}</span>}
      {it.breaking && <span class="tag">🔥突发</span>}
      {dlTag && !expired && <span class="tag">{dlTag}</span>}
      {expired && <span class="tag" style="background:var(--dim2)">已失效</span>}
      {it.title}
    </a>
  </h3>
  <a class="md" href={detail}>
    {(() => { const q = expired ? "已结束" : (it.quota ?? "免费"); const p = !expired && q.includes("→") ? q.split("→") : null;
      if (p) { const m = p[0].match(/^\D+/); if (m && !p[1].startsWith(m[0])) p[1] = m[0] + p[1].trim(); }
      return p
        ? <span class="q sale"><span class="now">{p[1]}</span><span class="was">原价 <s>{p[0]}</s></span></span>
        : <span class="q">{q}</span>; })()}
    <span class="ct">{claimName(it.claimType)}</span>
    {it.platform && <span class="pl">{it.platform}</span>}
  </a>
  <div class="bd">
    {it.summary && <div class="sum">{it.summary}</div>}
    <div class="src">{chName(it.category)}<i>·</i>{it.platform ?? it.sourceName ?? ""}<i>|</i>{date}</div>
    <div class="ft">
      <span class="ops">
        <span class="v">👍 {it.useful} 值</span>
        {it.claimed > 0 && <span class="ok2">✓ {it.claimed} 人领到</span>}
        {it.comments > 0 && <span class="st">💬 {it.comments}</span>}
        {it.views > 0 && <span class="st">👁 {it.views}</span>}
        {it.trusted && <span class="ok2">✓可信</span>}
      </span>
      {!expired && <a class="buy" href={goUrl(it)} target="_blank" rel="noopener">去领取 →</a>}
    </div>
  </div>
</div>
